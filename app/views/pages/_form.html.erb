<%= form_with(model: page, class: "space-y-6") do |form| %>
  <% if page.errors.any? %>
    <div class="bg-red-50 border-l-4 border-red-500 p-4 rounded-r-lg">
      <h2 class="text-lg font-semibold text-red-800 mb-2">
        <%= pluralize(page.errors.count, "erreur") %> empêche(nt) la sauvegarde :
      </h2>
      <ul class="list-disc list-inside text-red-700">
        <% page.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- Title Field -->
  <div class="bg-white p-6 rounded-lg shadow-md border-l-4" style="border-color: #3B82F6;">
    <%= form.label :title, "Titre de la page", class: "block text-lg font-semibold mb-2", style: "color: #1E40AF;" %>
    <%= form.text_field :title, 
        class: "block w-full px-4 py-3 text-lg rounded-lg border-2 focus:outline-none focus:border-blue-500 transition",
        style: "border-color: #E5E7EB;",
        placeholder: "Entrez le titre de votre page..." %>
  </div>

  <!-- Content Field -->
  <div class="bg-white p-6 rounded-lg shadow-md border-l-4" style="border-color: #3B82F6;">
    <%= form.label :content, "Contenu", class: "block text-lg font-semibold mb-2", style: "color: #1E40AF;" %>
    <%= form.text_area :content, 
        rows: 15, 
        class: "block w-full px-4 py-3 rounded-lg border-2 focus:outline-none focus:border-blue-500 transition font-mono",
        style: "border-color: #E5E7EB;",
        placeholder: "Écrivez le contenu de votre page..." %>
    <p class="mt-2 text-sm text-gray-500">💡 Support Markdown à venir prochainement</p>
  </div>

  <!-- Slug Field -->
  <div class="bg-white p-6 rounded-lg shadow-md border-l-4 border-gray-300">
    <%= form.label :slug, "URL personnalisée (optionnel)", class: "block text-lg font-semibold mb-2 text-gray-700" %>
    <%= form.text_field :slug, 
        class: "block w-full px-4 py-3 rounded-lg border-2 focus:outline-none focus:border-blue-500 transition font-mono",
        style: "border-color: #E5E7EB;",
        placeholder: "ma-page-personnalisee" %>
    <p class="mt-2 text-sm text-gray-500">
      <span class="font-semibold">Laissez vide</span> pour générer automatiquement depuis le titre
    </p>
  </div>

  <!-- Submit Buttons -->
  <div class="flex gap-4 pt-4">
    <%= form.submit "Enregistrer", 
        class: "flex items-center gap-2 px-6 py-3 text-base rounded-lg font-medium text-white hover:opacity-90 transition cursor-pointer", 
        style: "background-color: #3B82F6;" %>
    
    <%= link_to "Annuler", pages_path, 
        class: "flex items-center gap-2 px-6 py-3 text-base rounded-lg font-medium border-2 hover:bg-gray-50 transition", 
        style: "border-color: #E5E7EB; color: #6B7280;" %>
  </div>
<% end %>