<nav class="fixed top-0 left-0 right-0 z-50 shadow-md bg-white border-b-2" style="border-color: #3B82F6;">
  <div class="container mx-auto px-4">
    <div class="flex items-center justify-between h-16">
      
      <!-- Logo -->
      <div class="flex-shrink-0">
        <%= link_to root_path, class: "flex items-center gap-2 hover:opacity-80 transition" do %>
          <span class="text-2xl">📚</span>
          <span class="text-xl font-bold" style="color: #1E40AF;">Mon Wiki</span>
        <% end %>
      </div>

      <!-- Recherche -->
      <div class="flex-1 max-w-md mx-8">
        <%= form_with(url: pages_path, method: :get, local: true, class: "relative") do |f| %>
          <%= f.text_field :query, 
              value: params[:query],
              placeholder: "Rechercher dans le wiki...", 
              class: "w-full px-4 py-2 pl-10 text-sm rounded-lg border-2 focus:outline-none focus:border-blue-500 transition",
              style: "border-color: #E5E7EB; background-color: #F9FAFB;" %>
          <svg class="absolute left-3 top-2.5 w-5 h-5 text-gray-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        <% end %>
      </div>
      
      <!-- Boutons -->
      <div class="flex items-center gap-3">
        <% if user_signed_in? %>
          <span class="text-sm font-medium" style="color: #1E40AF;">👤 <%= current_user.username %></span>
          
          <%= link_to new_page_path, class: "flex items-center gap-2 px-4 py-2 text-sm rounded-lg font-medium text-white hover:opacity-90 transition", style: "background-color: #3B82F6;" do %>
            <span>➕</span>
            <span>Nouvelle page</span>
          <% end %>
          
          <%= link_to "🚪 Déconnexion", destroy_user_session_path, data: { turbo_method: :delete }, class: "px-4 py-2 text-sm rounded-lg font-medium text-white hover:opacity-90 transition", style: "background-color: #EF4444;" %>
        <% else %>
          <%= link_to "Connexion", new_user_session_path, class: "px-4 py-2 text-sm rounded-lg font-medium border-2 hover:bg-gray-50 transition", style: "border-color: #3B82F6; color: #1E40AF;" %>
          <%= link_to "Inscription", new_user_registration_path, class: "px-4 py-2 text-sm rounded-lg font-medium text-white hover:opacity-90 transition", style: "background-color: #3B82F6;" %>
        <% end %>
      </div>
      
    </div>
  </div>
</nav>